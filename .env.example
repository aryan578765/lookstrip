# LooksTrip client configuration
# Copy this to .env for local Flutter development.

# Backend proxy endpoint. Use your deployed Supabase Edge Function URL, e.g.
# https://YOUR_PROJECT_REF.functions.supabase.co/travel-proxy
BACKEND_PROXY_BASE_URL=

# User preference defaults
DEFAULT_DEPARTURE_AIRPORT=DEL

# Maps
MAPBOX_ACCESS_TOKEN=

# Backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
